  "provides": [
    {
      "slot": "router/1",
      "tool": "freerouting",
      "argv": [
        "--gui.enabled=false",
        "--usage_and_diagnostic_data.disable_analytics=true",
        "--feature_flags.save_jobs=false",
        "--logging.file.enabled=false",
        "--router.max_passes={maxPasses}",
        "--router.allowed_via_types={vias}",
        "--router.scoring.via_costs={viaCost}",
        "--router.fanout.enabled={fanout}",
        "--router.optimizer.enabled={optimizer}",
        "--router.max_threads={threads}",
        "-de",
        "{in.dsn}",
        "-do",
        "{out.ses}"
      ],
      "options": {
        "maxPasses": { "type": "int", "min": 1, "max": 1000, "default": 100, "pref": "freeroutingMaxPasses" },
        "threads": { "type": "int", "min": 0, "max": 64, "default": 0, "omitWhenDefault": true, "pref": "freeroutingThreads" },
        "viaCost": { "type": "int", "min": 1, "max": 1000, "default": 50, "pref": "freeroutingViaCost" },
        "vias": { "type": "bool", "default": true, "pref": "freeroutingVias" },
        "fanout": { "type": "bool", "default": true, "pref": "freeroutingFanout" },
        "optimizer": { "type": "bool", "default": true, "pref": "freeroutingOptimizer" },
        "timeoutMin": { "type": "int", "min": 1, "max": 120, "default": 10, "pref": "freeroutingTimeoutMin" }
      },
      "timeout": { "option": "timeoutMin", "unit": "min", "max": 120 },
      "success": "output"
    }
  ]
