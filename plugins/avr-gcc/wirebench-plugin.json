{
  "manifest": 1,
  "id": "wirebench.avr-gcc",
  "name": "avr-gcc",
  "version": "1.2.0",
  "requires": {"wirebench": ">=0.1"},
  "author": "wirebench",
  "licence": "GPL-3.0-or-later",
  "licenceUrl": "https://www.gnu.org/licenses/gpl-3.0.html",
  "homepage": "https://github.com/janslonecki/wirebench-plugins",
  "summary": {
    "en": "Compiles C for the MCU workbench. Bring your own, or let the Arduino AVR core install one.",
    "es": "Compila C para el banco de MCU. Usa el tuyo o deja que el núcleo AVR de Arduino instale uno."
  },
  "tools": [
    {
      "id": "avr-gcc",
      "binary": "avr-gcc",
      "envVar": "WIREBENCH_AVR_GCC",
      "probe": {
        "argv": ["--version"],
        "match": "^[^\\n]*?(\\d+\\.\\d+(?:\\.\\d+)*)"
      },
      "launch": { "kind": "exe" },
      "licence": "GPL-3.0",
      "licenceUrl": "https://www.gnu.org/licenses/gpl-3.0.html",
      "homepage": "https://gcc.gnu.org/wiki/avr-gcc",
      "candidates": "arduino-avr-core",
      "pref": "avrGccPath"
    }
  ],
  "provides": [
    {
      "slot": "mcu-compiler/1",
      "tool": "avr-gcc",
      "langs": ["c"],
      "argv": ["-mmcu=atmega328p", "-Os", "-std=gnu11", "{in.source}", "-o", "{out.elf}"],
      "timeout": { "default": 30, "unit": "s" },
      "success": "exit0"
    }
  ]
}
